def deshacer(fecha):
    if not FECHA_RE.match(fecha):
        sys.exit("Fecha no válida: usa AAAA-MM-DD")
    objetivos = []
    try:
        for l in REGISTRO.read_text(encoding="utf-8").splitlines():
            p = l.split("\t")
            if len(p) in (5, 6) and p[0][:10] >= fecha and p[2] == "archivar" and ID_RE.match(p[1]):
                clave = (p[1], len(p) == 6 and p[5] == "m")
                if clave not in objetivos:
                    objetivos.append(clave)
    except OSError:
        pass
    if not objetivos:
        print("No hay nada archivado desde esa fecha.")
        return
    g = Gmail(acceso())
    for ident, es_mensaje in objetivos:
        try:
            (g.cambiar_mensaje if es_mensaje else g.cambiar_hilo)(ident, poner=["INBOX"])
            anotar(ident, "devolver", "-", "deshacer", "m" if es_mensaje else "h")
        except ErrorGmail as e:
            print(f"  {ident}: {e}")
    print(f"Devueltos a la bandeja: {len(objetivos)}.")


def conectar():
    """Autorizacion de escritorio con PKCE: el navegador de Windows vuelve a 127.0.0.1 en WSL."""
    cliente = leer_json(CLIENTE, {})
    if not cliente.get("client_id"):
        sys.exit("Falta el cliente: ejecuta «sudo oficina-correo conectar <cliente.json>».")
    verificador = secrets.token_urlsafe(64)
    reto = base64.urlsafe_b64encode(hashlib.sha256(verificador.encode()).digest()).rstrip(b"=").decode()
    marca = secrets.token_urlsafe(24)
    recibido = {}

    class Vuelta(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if q.get("state", [""])[0] == marca and "code" in q:
                recibido["code"] = q["code"][0]
                texto = "Listo: ya puedes cerrar esta pestaña y volver a la terminal."
            else:
                texto = "Esta respuesta no es la que esperaba la Oficina."
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(texto.encode())

        def log_message(self, *_):
            pass

    servidor = http.server.HTTPServer(("127.0.0.1", 0), Vuelta)
    servidor.timeout = 300
    vuelta = f"http://127.0.0.1:{servidor.server_port}/"
    url = AUTORIZAR_URL + "?" + urllib.parse.urlencode({
        "client_id": cliente["client_id"], "redirect_uri": vuelta, "response_type": "code", "scope": ALCANCE,
        "access_type": "offline", "prompt": "consent", "state": marca, "code_challenge": reto, "code_challenge_method": "S256",
    })
    print("Abre esta dirección en el navegador del PC e inicia sesión con tu cuenta de Gmail:\n")
    print(url + "\n")
    print("Esperando la respuesta (5 minutos como mucho)...")
    hilo = threading.Thread(target=lambda: [servidor.handle_request() for _ in range(20) if "code" not in recibido], daemon=True)
    hilo.start()
    hilo.join(300)
    servidor.server_close()
    if "code" not in recibido:
        sys.exit("No ha llegado la autorización.")
    r = pedir_token({"client_id": cliente["client_id"], "client_secret": cliente.get("client_secret", ""), "code": recibido["code"],
                     "code_verifier": verificador, "redirect_uri": vuelta, "grant_type": "authorization_code"})
    if not isinstance(r.get("refresh_token"), str):
        sys.exit("Google no ha dado un permiso permanente. Quita el acceso de la app en tu cuenta de Google y repite.")
    if ALCANCE not in str(r.get("scope", "")).split():
        sys.exit("No se ha concedido el permiso de Gmail: repite y marca la casilla de Gmail.")
    escribir_json(TOKEN, {"refresh_token": r["refresh_token"], "fecha": ahora_iso()})
    estado = leer_json(ESTADO, {})
    estado.pop("historia", None)  # Empieza desde ahora.
    escribir_json(ESTADO, estado)
    print("Cuenta conectada. El vigilante empieza en la próxima pasada (5 minutos como mucho).")


def validar_cliente(texto):
    try:
        d = json.loads(texto)
    except ValueError:
        return None
    c = d.get("installed") if isinstance(d, dict) else None
    if not isinstance(c, dict) or not isinstance(c.get("client_id"), str) or not re.fullmatch(r"[0-9A-Za-z._-]{10,200}\.apps\.googleusercontent\.com", c["client_id"]):
        return None
    secreto = c.get("client_secret", "")
    if not isinstance(secreto, str) or len(secreto) > 200:
        return None
    return {"installed": {"client_id": c["client_id"], "client_secret": secreto}}


def guardar_cliente():
    """Como `correo`: recibe el cliente ya revisado por la entrada estandar y lo guarda el mismo."""
    c = validar_cliente(sys.stdin.read(16 * 1024))
    if c is None:
        sys.exit("Cliente OAuth no válido.")
    escribir_json(CLIENTE, c["installed"])


def preparar_cliente(ruta):
    """Con sudo: root solo lee y revisa tu archivo. No escribe ni cambia nada en la carpeta de `correo`."""
    try:
        with open(ruta, encoding="utf-8") as f:
            texto = f.read(16 * 1024)
    except OSError:
        sys.exit("No se puede leer ese archivo del cliente OAuth.")
    c = validar_cliente(texto)
    if c is None:
        sys.exit("Ese archivo no es un cliente OAuth de tipo «Aplicación de escritorio».")
    r = subprocess.run(["runuser", "-u", USUARIO, "--", *ENTORNO_LIMPIO, sys.executable, "-I", os.path.abspath(sys.argv[0]), "_guardar-cliente"],
                       input=json.dumps(c), text=True, check=False)
    if r.returncode != 0:
        sys.exit("No se ha podido guardar el cliente.")


def como_correo():
    """Las ordenes que tocan los datos corren siempre como `correo`, aunque se lancen con sudo, y sin heredar el entorno."""
    if ES_ROOT:
        os.execvp("runuser", ["runuser", "-u", USUARIO, "--", *ENTORNO_LIMPIO, sys.executable, "-I", os.path.abspath(sys.argv[0]), *sys.argv[1:]])


def aplicar_reglas():
    if not ES_ROOT:
        sys.exit("Ejecútalo con sudo: las reglas en uso no las puede cambiar ningún agente.")
    try:
        nuevo = leer_boveda()
    except (OSError, UnicodeDecodeError) as e:
        sys.exit(f"No se puede leer «Conocimiento/Correo - reglas.md» de la bóveda como archivo normal ({type(e).__name__}: {e}). "
                 "Si es un enlace, una carpeta o un archivo enorme, no se usa.")
    raras = lineas_raras(nuevo)
    if raras:
        sys.exit(f"El archivo de reglas tiene caracteres de control o invisibles en las líneas {', '.join(map(str, raras[:20]))}. "
                 "Podrían esconder cambios en la pantalla: no se aplica. Quítalos y repite.")
    viejo = REGLAS.read_text(encoding="utf-8") if REGLAS.exists() else ""
    cambios = list(difflib.unified_diff(viejo.splitlines(), nuevo.splitlines(), "en uso", "bóveda", lineterm=""))
    if not cambios:
        print("Las reglas de la bóveda ya son las que están en uso.")
        return
    print("\n".join(cambios))
    r = leer_reglas(nuevo)
    print("\nQuedarían: " + ", ".join(f"{ETIQUETAS[c]} {len(r[c])}" for c in CLASES))
    if input("\n¿Aplicar estos cambios? Escribe «aplicar»: ").strip() != "aplicar":
        sys.exit("No se ha cambiado nada.")
    REGLAS.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".correo-reglas.", dir=REGLAS.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            os.fchmod(f.fileno(), 0o644)
            f.write(nuevo)
        os.replace(tmp, REGLAS)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise
    print("Reglas aplicadas.")


def con_cerrojo(esperar):
    """Una sola orden a la vez sobre estado.json: el temporizador y tus ordenes no se pisan."""
    fd = os.open(CERROJO, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if not esperar:
            os.close(fd)
            return None
        print("Esperando a que termine la pasada en curso...", file=sys.stderr)
        fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def main():
    os.umask(0o077)
    args = sys.argv[1:]
    orden = args[0] if args else ""
    if orden == "reglas":
        return aplicar_reglas()
    if orden == "conectar" and len(args) == 2 and ES_ROOT:
        preparar_cliente(args[1])
    como_correo()
    if orden == "_guardar-cliente":
        return guardar_cliente()
    if orden == "estado":
        return ver_estado()
    if orden not in ("ciclo", "pausar", "reanudar", "conectar", "deshacer"):
        print(__doc__)
        return 2
    cerrojo = con_cerrojo(esperar=orden != "ciclo")
    if cerrojo is None:
        return 0  # Ya hay una pasada en marcha.
    if orden == "ciclo":
        return ciclo()
    if orden == "pausar":
        PAUSA.touch()
        publicar(leer_json(ESTADO, {}))
        print("Vigilante en pausa.")
        return 0
    if orden == "reanudar":
        PAUSA.unlink(missing_ok=True)
        e = leer_json(ESTADO, {})
        e.setdefault("ia", {}).pop("pago", None)
        escribir_json(ESTADO, e)
        publicar(e)
        print("Vigilante en marcha.")
        return 0
    if orden == "conectar" and len(args) in (1, 2):
        return conectar()
    if orden == "deshacer" and len(args) == 2:
        return deshacer(args[1])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main() or 0)
