def asegurar_etiquetas(g):
    ids = {}
    existentes = {e.get("name"): e.get("id") for e in g.etiquetas() if isinstance(e, dict)}
    for clase, nombre in ETIQUETAS.items():
        lid = existentes.get(nombre) or g.crear_etiqueta(nombre).get("id")
        if not isinstance(lid, str) or not ETIQUETA_RE.match(lid):
            raise ErrorGmail(0, f"no se puede usar la etiqueta {nombre}")
        ids[clase] = lid
    return ids


def leer_correo(g, mid, etiquetas):
    m = g.mensaje(mid)
    hilo = m.get("threadId")
    etiq = [e for e in (m.get("labelIds") or []) if isinstance(e, str)]
    if not isinstance(hilo, str) or not ID_RE.match(hilo):
        return None
    cabeceras = {}
    for h in (m.get("payload") or {}).get("headers") or []:
        if isinstance(h, dict) and isinstance(h.get("name"), str) and isinstance(h.get("value"), str):
            cabeceras.setdefault(h["name"].lower(), h["value"])  # La primera: la que pone Gmail al recibirlo.
    direccion, nombre = remitente(cabeceras.get("from", ""))
    return {
        "id": mid, "hilo": hilo, "etiquetas": etiq, "cabeceras": cabeceras,
        "autenticacion": cabeceras.get("authentication-results", ""),
        "direccion": direccion, "de_texto": limpio(cabeceras.get("from", ""), 120), "nombre": nombre,
        "asunto": limpio(cabeceras.get("subject", ""), 200), "extracto": limpio(m.get("snippet", ""), 300),
        "ya": "INBOX" not in etiq or any(e in etiq for e in (*etiquetas.values(), "SENT", "DRAFT", "SPAM", "TRASH")),
    }


def aplicar(g, correo, clase, origen, etiquetas, avisos):
    clase, origen = decidir(clase, origen, correo)
    poner, quitar = [etiquetas[clase]], []
    if clase == "publicidad":
        quitar.append("INBOX")
    if clase == "prioritario":
        poner.append("STARRED")
    g.cambiar_mensaje(correo["id"], poner, quitar)
    anotar(correo["id"], "archivar" if quitar else "etiquetar", clase, origen)
    if clase == "prioritario":
        avisos.append({"hilo": correo["hilo"], "de": correo["nombre"], "asunto": limpio(correo["asunto"], 120), "hora": int(time.time())})


def archivar_avisos_viejos(g):
    hechos = 0
    for mid in g.buscar(f'in:inbox label:"{ETIQUETAS["aviso"]}" older_than:{DIAS_AVISO}d'):
        g.cambiar_mensaje(mid, quitar=["INBOX"])
        anotar(mid, "archivar", "aviso", "pasados")
        hechos += 1
    return hechos


def publicar(estado, nuevos=()):
    """El panel solo ve esto: avisos saneados de las ultimas 48 h y el estado del vigilante."""
    previos = leer_json(AVISOS, {}).get("avisos") or []
    limite = time.time() - VIDA_AVISO_S
    avisos = [a for a in [*previos, *nuevos] if isinstance(a, dict) and numero(a.get("hora"), limite, 1e11) is not None]
    vistos, unicos = set(), []
    for a in reversed(avisos):
        if a.get("hilo") not in vistos and ID_RE.match(str(a.get("hilo"))):
            vistos.add(a["hilo"])
            unicos.append({"hilo": a["hilo"], "de": limpio(a.get("de"), 60), "asunto": limpio(a.get("asunto"), 120), "hora": int(a["hora"])})
    puede, motivo = ia_disponible(estado)
    escribir_json(AVISOS, {
        "hora": int(time.time()), "pausa": PAUSA.exists(), "conectado": TOKEN.exists(),
        "ia": "ok" if puede else limpio(motivo, 60), "error": limpio(estado.get("error"), 160),
        "avisos": unicos[:MAX_AVISOS],
    }, 0o640)


def ciclo():
    estado = leer_json(ESTADO, {})
    if PAUSA.exists():
        publicar(estado)
        return 0
    nuevos = []
    try:
        g = Gmail(acceso())
        etiquetas = asegurar_etiquetas(g)
        if not HISTORIA_RE.match(str(estado.get("historia", ""))):
            # La primera vez solo se marca el punto de partida: lo antiguo ya lo ordenaste tu.
            estado["historia"] = str(g.perfil().get("historyId", ""))
            estado.pop("error", None)
            return 0
        try:
            ids, ultimo = g.historial(estado["historia"])
        except ErrorGmail as e:
            if e.codigo != 404:
                raise
            estado["historia"] = str(g.perfil().get("historyId", ""))  # Historial caducado: se sigue desde ahora.
            ids, ultimo = [], estado["historia"]
        pendientes = [p for p in estado.get("pendientes", []) if isinstance(p, str) and ID_RE.match(p)]
        cola = list(dict.fromkeys([*pendientes, *ids]))
        sobrante = cola[MAX_POR_CICLO:]
        reglas = leer_reglas(REGLAS.read_text(encoding="utf-8")) if REGLAS.exists() else {c: [] for c in CLASES}
        sin_regla = []
        for mid in cola[:MAX_POR_CICLO]:
            try:
                correo = leer_correo(g, mid, etiquetas)
            except ErrorGmail as e:
                if e.codigo == 404:
                    continue  # Ya no existe: lo borraste tu.
                raise
            if correo is None or correo["ya"]:
                continue
            clase = segun_reglas(reglas, correo)
            if clase:
                aplicar(g, correo, clase, "regla", etiquetas, nuevos)
            else:
                sin_regla.append(correo)
        intentos = {k: v for k, v in (estado.get("intentos") or {}).items() if isinstance(k, str) and isinstance(v, int)}
        quedan = []
        for i in range(0, len(sin_regla), POR_LLAMADA_IA):
            lote = sin_regla[i:i + POR_LLAMADA_IA]
            puede, _ = ia_disponible(estado)
            clases = preguntar_ia(estado, lote) if puede else None
            if clases is None:
                for c in lote:
                    # Si el clasificador contesta con error una y otra vez, el correo no se queda dando vueltas.
                    if estado["ia"].get("fallo_respuesta"):
                        intentos[c["id"]] = intentos.get(c["id"], 0) + 1
                    if intentos.get(c["id"], 0) >= MAX_INTENTOS_IA:
                        aplicar(g, c, "revisar", "ia-fallida", etiquetas, nuevos)
                        intentos.pop(c["id"], None)
                    else:
                        quedan.append(c["id"])
                continue
            for n, correo in enumerate(lote, 1):
                aplicar(g, correo, clases[n], "ia", etiquetas, nuevos)
                intentos.pop(correo["id"], None)
        estado["pendientes"] = (quedan + sobrante)[:MAX_PENDIENTES]
        estado["intentos"] = {k: v for k, v in intentos.items() if k in estado["pendientes"]}
        archivar_avisos_viejos(g)
        estado["historia"] = ultimo
        estado["ultimo_ciclo"] = ahora_iso()
        estado.pop("error", None)
        return 0
    except ErrorGmail as e:
        estado["error"] = str(e)
        print(f"oficina-correo: {e}", file=sys.stderr)
        return 0 if e.codigo == SIN_CONECTAR else 1
    finally:
        escribir_json(ESTADO, estado)
        publicar(estado, nuevos)


