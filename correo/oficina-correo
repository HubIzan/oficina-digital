# ----------------------------------------------------------------- utilidades

def ahora_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def limpio(texto, maximo):
    """Una linea, sin caracteres de control ni de direccion de texto, y corta."""
    if not isinstance(texto, str):
        return ""
    t = CONTROL_RE.sub(" ", texto)
    t = " ".join(t.split())
    return t[:maximo]


def escribir_json(ruta, datos, modo=0o600):
    """Temporal exclusivo y con nombre al azar: nadie puede dejar preparado un enlace en su sitio."""
    fd, tmp = tempfile.mkstemp(prefix=f".{ruta.name}.", dir=ruta.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            os.fchmod(f.fileno(), modo)
            json.dump(datos, f, ensure_ascii=False, indent=1)
            f.write("\n")
        os.replace(tmp, ruta)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def leer_json(ruta, defecto):
    try:
        fd = os.open(ruta, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as f:
            if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
                return defecto
            d = json.loads(f.read(1024 * 1024))
    except (OSError, ValueError):
        return defecto
    return d if isinstance(d, type(defecto)) else defecto


def anotar(ident, accion, clase, origen, tipo="m"):
    """tipo «m»: un mensaje. Las lineas antiguas, sin tipo, son de un hilo entero."""
    linea = f"{ahora_iso()}\t{ident}\t{accion}\t{clase}\t{origen}\t{tipo}\n"
    fd = os.open(REGISTRO, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as f:
        f.write(linea)


def numero(v, minimo, maximo):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) and minimo <= v <= maximo else None


SIN_CONECTAR = -1  # No es un fallo: todavia no has autorizado la cuenta.


class ErrorGmail(Exception):
    def __init__(self, codigo, mensaje):
        super().__init__(mensaje)
        self.codigo = codigo


class SinRedireccion(urllib.request.HTTPRedirectHandler):
    """Una redireccion reenviaria el permiso a otra direccion: se trata como error."""

    def redirect_request(self, *_):
        return None


ABRIR = urllib.request.build_opener(SinRedireccion).open


# ----------------------------------------------------------------- Google

def pedir_token(campos):
    cuerpo = urllib.parse.urlencode(campos).encode()
    pet = urllib.request.Request(TOKEN_URL, data=cuerpo, headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with ABRIR(pet, timeout=TIEMPO_RED_S) as r:
            return json.loads(r.read(64 * 1024))
    except urllib.error.HTTPError as e:
        raise ErrorGmail(e.code, f"Google no da acceso ({e.code}): vuelve a ejecutar «sudo oficina-correo conectar»") from None
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise ErrorGmail(0, f"sin conexión con Google ({type(e).__name__})") from None


def acceso():
    cliente = leer_json(CLIENTE, {})
    token = leer_json(TOKEN, {})
    if not cliente.get("client_id") or not token.get("refresh_token"):
        raise ErrorGmail(SIN_CONECTAR, "Falta conectar la cuenta: «sudo oficina-correo conectar <cliente.json>»")
    r = pedir_token({"client_id": cliente["client_id"], "client_secret": cliente.get("client_secret", ""),
                     "refresh_token": token["refresh_token"], "grant_type": "refresh_token"})
    if not isinstance(r.get("access_token"), str):
        raise ErrorGmail(0, "Google no ha devuelto acceso")
    return r["access_token"]


class Gmail:
    """Las unicas llamadas que existen. Cualquier otra ruta da error antes de salir a la red."""

    PERMITIDAS = {
        ("GET", "profile"), ("GET", "history"), ("GET", "messages"), ("GET", "messages/*"), ("GET", "labels"),
        ("POST", "labels"), ("POST", "messages/*/modify"), ("POST", "threads/*/modify"),
    }

    def __init__(self, token):
        self.token = token
        self.llamadas = []

    @staticmethod
    def forma(ruta):
        partes = ruta.split("/")
        if len(partes) >= 2:
            partes[1] = "*"
        return "/".join(partes)

    def llamar(self, metodo, ruta, consulta=None, cuerpo=None):
        if (metodo, self.forma(ruta)) not in self.PERMITIDAS:
            raise ErrorGmail(0, f"llamada no permitida: {metodo} {ruta}")
        url = f"{API}/{ruta}"
        if consulta:
            url += "?" + urllib.parse.urlencode(consulta, doseq=True)
        datos = json.dumps(cuerpo).encode() if cuerpo is not None else None
        pet = urllib.request.Request(url, data=datos, method=metodo, headers={"Authorization": f"Bearer {self.token}", "Content-Type": "application/json"})
        self.llamadas.append((metodo, ruta))
        try:
            with ABRIR(pet, timeout=TIEMPO_RED_S) as r:
                crudo = r.read(2 * 1024 * 1024)
        except urllib.error.HTTPError as e:
            raise ErrorGmail(e.code, f"Gmail respondió {e.code} en {ruta.split('/')[0]}") from None
        except (urllib.error.URLError, OSError) as e:
            raise ErrorGmail(0, f"sin conexión con Gmail ({type(e).__name__})") from None
        try:
            d = json.loads(crudo) if crudo else {}
        except ValueError:
            raise ErrorGmail(0, "respuesta de Gmail ilegible") from None
        return d if isinstance(d, dict) else {}

    def perfil(self):
        return self.llamar("GET", "profile")

    def historial(self, desde):
        ids, ultimo, pagina = [], desde, None
        for _ in range(MAX_PAGINAS):
            consulta = {"startHistoryId": desde, "historyTypes": "messageAdded", "labelId": "INBOX", "maxResults": 500}
            if pagina:
                consulta["pageToken"] = pagina
            d = self.llamar("GET", "history", consulta)
            for h in d.get("history") or []:
                for m in (h.get("messagesAdded") or []) if isinstance(h, dict) else []:
                    mid = (m.get("message") or {}).get("id") if isinstance(m, dict) else None
                    if isinstance(mid, str) and ID_RE.match(mid) and mid not in ids:
                        ids.append(mid)
            if isinstance(d.get("historyId"), str) and HISTORIA_RE.match(d["historyId"]):
                ultimo = d["historyId"]
            pagina = d.get("nextPageToken")
            if not isinstance(pagina, str) or not pagina:
                break
        return ids, ultimo

    def mensaje(self, mid):
        return self.llamar("GET", f"messages/{mid}", {"format": "metadata", "metadataHeaders": CABECERAS})

    def buscar(self, q, maximo=100):
        d = self.llamar("GET", "messages", {"q": q, "maxResults": maximo})
        return [m["id"] for m in d.get("messages") or [] if isinstance(m, dict) and isinstance(m.get("id"), str) and ID_RE.match(m["id"])]

    def etiquetas(self):
        return self.llamar("GET", "labels").get("labels") or []

    def crear_etiqueta(self, nombre):
        return self.llamar("POST", "labels", cuerpo={"name": nombre, "labelListVisibility": "labelShow", "messageListVisibility": "show"})

    @staticmethod
    def _comprobar(ident, poner, quitar):
        if not ID_RE.match(ident):
            raise ErrorGmail(0, "identificador no válido")
        for e in (*poner, *quitar):
            if not ETIQUETA_RE.match(e):
                raise ErrorGmail(0, "etiqueta no válida")
        # Nunca TRASH ni SPAM, aunque alguien lo cuele en una regla.
        if {"TRASH", "SPAM"} & set(poner):
            raise ErrorGmail(0, "papelera y spam no se usan")

    def cambiar_mensaje(self, mid, poner=(), quitar=()):
        """Solo el mensaje clasificado: los demas de la conversacion no se tocan."""
        self._comprobar(mid, poner, quitar)
        self.llamar("POST", f"messages/{mid}/modify", cuerpo={"addLabelIds": list(poner), "removeLabelIds": list(quitar)})

    def cambiar_hilo(self, hilo, poner=(), quitar=()):
        """Solo para deshacer lo que se archivo por hilos antes del 2026-11-11."""
        self._comprobar(hilo, poner, quitar)
        self.llamar("POST", f"threads/{hilo}/modify", cuerpo={"addLabelIds": list(poner), "removeLabelIds": list(quitar)})


# ----------------------------------------------------------------- reglas

def leer_reglas(texto):
    """Secciones «## Prioritario|Revisar|Avisos pasados|Publicidad» con lineas «- patron»."""
    reglas = {c: [] for c in CLASES}
    actual = None
    for linea in texto.splitlines():
        l = linea.strip()
        if l.startswith("## "):
            actual = SECCIONES.get(l[3:].strip().lower())
            continue
        if actual is None or not l.startswith("- "):
            continue
        p = l[2:].split("#", 1)[0].strip()
        if not p:
            continue
        if p.lower().startswith("asunto:"):
            valor = p[7:].strip().lower()
            if len(valor) >= 3:
                reglas[actual].append(("asunto", valor[:120]))
        elif p.lower().startswith("categoria:"):
            cat = CATEGORIAS.get(p[10:].strip().lower())
            if cat:
                reglas[actual].append(("categoria", cat))
        elif re.fullmatch(r"@[a-z0-9.-]+\.[a-z]{2,24}", p.lower()):
            reglas[actual].append(("dominio", p.lower()[1:]))
        elif re.fullmatch(r"[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,24}", p.lower()):
            reglas[actual].append(("direccion", p.lower()))
    return reglas


def lineas_raras(texto):
    """Numeros de linea con caracteres de control o invisibles: podrian esconder algo en la pantalla."""
    return [n for n, l in enumerate(texto.splitlines(), 1) if CONTROL_RE.search(l)]


def leer_boveda(raiz=None, partes=REGLAS_EN_BOVEDA):
    """Lee el archivo de reglas de la boveda sin seguir enlaces en ningun tramo: los agentes escriben ahi."""
    raiz = raiz or BOVEDA
    fd = os.open(raiz, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for parte in partes[:-1]:
            nuevo = os.open(parte, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nuevo
        hoja = os.open(partes[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=fd)
    finally:
        os.close(fd)
    with os.fdopen(hoja, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise OSError("no es un archivo normal")
        crudo = f.read(MAX_REGLAS + 1)
    if len(crudo) > MAX_REGLAS:
        raise OSError("demasiado grande")
    return crudo.decode("utf-8")


# ----------------------------------------------------------------- remitente

def remitente(cabecera):
    """(direccion, nombre) con el analizador de correo: un «<otra@direccion>» en el nombre no cuenta."""
    pares = email.utils.getaddresses([cabecera or ""])
    pares = [(n, d) for n, d in pares if d]
    if len(pares) != 1:
        return "", limpio(cabecera, 60)
    nombre, direccion = pares[0]
    direccion = direccion.strip().lower()
    if direccion.count("@") != 1 or not DOMINIO_RE.match(direccion.rsplit("@", 1)[1]):
        return "", limpio(nombre or cabecera, 60)
    return direccion, limpio(nombre or direccion, 60)


def alineado(a, b):
    return bool(a) and bool(b) and (a == b or a.endswith("." + b) or b.endswith("." + a))


def autenticado(correo):
    """¿Confirma Gmail que el correo viene del dominio del remitente? Solo vale su propia cabecera, la primera."""
    ar = (correo.get("autenticacion") or "").lower()
    dominio = correo["direccion"].rsplit("@", 1)[-1] if correo["direccion"] else ""
    if not dominio or not ar.startswith("mx.google.com;"):
        return False
    for patron in (r"\bdmarc=pass\b[^;]*?\bheader\.from=([a-z0-9.-]+)",
                   r"\bdkim=pass\b[^;]*?\bheader\.[id]=@?([a-z0-9.-]+)",
                   r"\bspf=pass\b[^;]*?\bsmtp\.mailfrom=(?:[^@\s;]*@)?([a-z0-9.-]+)"):
        if any(alineado(d, dominio) for d in re.findall(patron, ar)):
            return True
    return False


def masivo(correo):
    """Cabeceras de envio masivo o automatico: un correo personal no las lleva, y nadie puede ponerselas al de otro."""
    c = correo.get("cabeceras") or {}
    if c.get("list-unsubscribe") or c.get("list-id"):
        return True
    if c.get("precedence", "").strip().lower() in ("bulk", "list", "junk"):
        return True
    auto = c.get("auto-submitted", "").strip().lower()
    return bool(auto) and auto != "no"


def decidir(clase, origen, correo):
    """Lo que puede hacer cada origen. Las reglas mandan; la IA nunca archiva un correo personal."""
    if clase == "prioritario" and not autenticado(correo):
        return "revisar", f"{origen}-sin-firma"
    if origen == "ia" and clase in ("publicidad", "aviso") and not masivo(correo):
        return "revisar", "ia-no-masivo"
    return clase, origen


def segun_reglas(reglas, correo):
    direccion = correo["direccion"]
    dominio = direccion.rsplit("@", 1)[-1] if direccion else ""
    asunto = correo["asunto"].lower()
    for clase in ("prioritario", "revisar", "aviso", "publicidad"):
        for tipo, valor in reglas.get(clase, []):
            if ((tipo == "direccion" and direccion == valor)
                    or (tipo == "dominio" and (dominio == valor or dominio.endswith("." + valor)))
                    or (tipo == "asunto" and valor in asunto)
                    or (tipo == "categoria" and valor in correo["etiquetas"])):
                return clase
    return None


# ----------------------------------------------------------------- IA

def ia_disponible(estado):
    ia = estado.setdefault("ia", {})
    hoy = datetime.date.today().isoformat()
    if ia.get("dia") != hoy:
        ia["dia"], ia["llamadas"] = hoy, 0
    if ia.get("pago"):
        return False, "pago por uso detectado"
    if PAUSA_COLA.exists():
        return False, "Oficina en pausa"
    if ia.get("llamadas", 0) >= MAX_LLAMADAS_IA_DIA:
        return False, "límite diario de la IA"
    for nombre, limite in LIMITES_IA.items():
        v = (ia.get("cuota") or {}).get(nombre) or {}
        uso, renueva = numero(v.get("uso"), 0, 1.5), numero(v.get("renueva"), 1e9, 1e11)
        if uso is not None and uso >= limite and renueva is not None and renueva > time.time():
            return False, f"cuota {nombre} alta"
    return True, None


def preguntar_ia(estado, lote):
    """Manda hasta 10 correos al clasificador. Devuelve {n: clase}, o None con el motivo en estado."""
    peticion = {"correos": [{"n": i, "de": c["de_texto"], "asunto": c["asunto"], "texto": c["extracto"]} for i, c in enumerate(lote, 1)]}
    ia = estado["ia"]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(TIEMPO_IA_S)
            s.connect(SOCKET_IA)
            ia["llamadas"] = ia.get("llamadas", 0) + 1  # Solo cuenta si de verdad llega al clasificador.
            s.sendall(json.dumps(peticion, ensure_ascii=False).encode() + b"\n")
            s.shutdown(socket.SHUT_WR)
            crudo = b""
            while len(crudo) < 64 * 1024:
                trozo = s.recv(8192)
                if not trozo:
                    break
                crudo += trozo
        r = json.loads(crudo or b"{}")
    except OSError:
        ia["error"] = "el clasificador no responde"
        return None
    except ValueError:
        r = {"error": "respuesta ilegible"}
    if not isinstance(r, dict):
        r = {"error": "respuesta ilegible"}
    if r.get("pago") is True:
        ia["pago"] = True
    cuota = r.get("cuota")
    if isinstance(cuota, dict):
        ia["cuota"] = {k: {"uso": numero(v.get("uso"), 0, 1.5), "renueva": numero(v.get("renueva"), 1e9, 1e11)}
                       for k, v in cuota.items() if k in LIMITES_IA and isinstance(v, dict)}
    if r.get("error"):
        ia["error"] = limpio(str(r["error"]), 120)
        ia["fallo_respuesta"] = True
        return None
    ia.pop("error", None)
    ia.pop("fallo_respuesta", None)
    clases = r.get("clases") if isinstance(r.get("clases"), dict) else {}
    return {i: (clases.get(str(i)) if clases.get(str(i)) in CLASES else "revisar") for i in range(1, len(lote) + 1)}


