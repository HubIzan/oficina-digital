#!/usr/bin/env bash
# Oficina Digital · © 2026 Izan Trompeta (HubIzan) · Licencia MIT · https://github.com/HubIzan/oficina-digital
# Lanzador de Claude Code para la Oficina: se niega a arrancar si algo
# pudiera desviar el uso de la suscripcion a un pago por uso.
set -euo pipefail

PROHIBIDAS=(
  ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_PROFILE
  ANTHROPIC_FEDERATION_RULE_ID CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
  CLAUDE_CODE_USE_FOUNDRY OPENAI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY
)

for v in "${PROHIBIDAS[@]}"; do
  if [ -n "${!v:-}" ]; then
    echo "oficina-claude: bloqueado, la variable $v esta definida." >&2
    exit 64
  fi
done

for a in "$@"; do
  if [ "$a" = "--bare" ]; then
    echo "oficina-claude: bloqueado, --bare no usa la suscripcion." >&2
    exit 64
  fi
done

exec claude "$@"
