    limpio = visible(v).strip()
    if len(limpio) > maximo:
        raise Rechazo(f"{nombre}: como mucho {maximo} caracteres.")
    if obligatorio and not limpio:
        raise Rechazo(f"{nombre}: es obligatorio.")
    return limpio


def encargo_web(pet):
    """Valida el formulario y lo deja en una forma fija: de ella sale la huella que se aprueba."""
    proyecto = comprobar_proyecto(pet.get("proyecto"))
    plantilla = plantilla_de(proyecto)
    if plantilla is None:
        raise Rechazo("ese proyecto no es una web profesional: crealo con la plantilla web-pro o astro.")
    c = pet.get("campos") if isinstance(pet.get("campos"), dict) else {}
    modo = c.get("modo")
    if modo not in ("personal", "cliente"):
        raise Rechazo("el modo debe ser personal o cliente.")
    paginas = c.get("paginas") if isinstance(c.get("paginas"), list) else []
    paginas = [texto_web(x, 60, nombre="pagina") for x in paginas[:MAX_PAGINAS + 1]]
    paginas = [x for x in paginas if x]
    if not paginas or len(paginas) > MAX_PAGINAS:
        raise Rechazo(f"indica entre 1 y {MAX_PAGINAS} paginas.")
    idiomas = c.get("idiomas") if isinstance(c.get("idiomas"), list) else []
    if not idiomas or any(i not in IDIOMAS for i in idiomas) or len(set(idiomas)) != len(idiomas):
        raise Rechazo("idiomas no validos.")
    t = c.get("titular") if isinstance(c.get("titular"), dict) else {}
    titular = {"nombre": texto_web(t.get("nombre"), 120, True, "titular"), "nif": texto_web(t.get("nif"), 12, nombre="NIF").upper(),
               "domicilio": texto_web(t.get("domicilio"), 200, nombre="domicilio"), "email": texto_web(t.get("email"), 120, True, "correo"),
               "dominio": texto_web(t.get("dominio"), 100, nombre="dominio").lower().removeprefix("https://").rstrip("/")}
    if not CORREO_RE.match(titular["email"]):
        raise Rechazo("el correo no es valido.")
    if titular["nif"] and not NIF_RE.match(titular["nif"]):
        raise Rechazo("el NIF no es valido.")
    if titular["dominio"] and not DOMINIO_RE.match(titular["dominio"]):
        raise Rechazo("el dominio no es valido (ejemplo: midominio.es).")
    if modo == "cliente" and not (titular["nif"] and titular["domicilio"]):
        raise Rechazo("en una web de cliente hacen falta NIF y domicilio del titular.")
    return {
        "proyecto": proyecto, "plantilla": plantilla, "modo": modo,
        "finalidad": texto_web(c.get("finalidad"), 1000, True, "para que es"),
        "publico": texto_web(c.get("publico"), 500, True, "a quien va dirigida"),
        "paginas": paginas, "estilo": texto_web(c.get("estilo"), 500, nombre="estilo"),
        "colores": texto_web(c.get("colores"), 200, nombre="colores"), "textos": texto_web(c.get("textos"), 3000, nombre="textos"),
        "idiomas": idiomas, "titular": titular, "referencias": referencias(proyecto),
    }


