        raise Rechazo("Triage ya tiene mensajes en espera: aguarda a que responda.")
    hace_un_dia = time.time() - 86400
    if sum(1 for f, _, _ in todas if f.stat().st_mtime > hace_un_dia) >= MAX_TRIAGE_DIA:
        raise Rechazo("limite diario de mensajes a Triage alcanzado: asi no se gasta la cuota por error.")
    extra = {}
