PUERTO_VISTA = 8092
VISTA_MIN = 30
# Este canal no tiene red: construir necesita descargar la imagen base, asi que lo hace oficina-vista.
SOCKET_VISTA = os.environ.get("OFICINA_VISTA_SOCK", "/run/oficina-vista.sock")
TIEMPO_VISTA_S = 1000


def pedir_vista(proyecto, sha):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(TIEMPO_VISTA_S)
    try:
        s.connect(SOCKET_VISTA)
        s.sendall(f"{proyecto} {sha}\n".encode("ascii"))
        datos = b""
        while len(datos) < 64 * 1024:
            trozo = s.recv(65536)
            if not trozo:
                break
            datos += trozo
    except OSError as e:
        raise Rechazo("el servicio de vistas no responde: ¿está instalado?") from e
    finally:
        s.close()
    texto, _, codigo = datos.decode("utf-8", errors="replace").rpartition("__CODIGO__ ")
    return codigo.strip(), texto.strip()


def ver_web(pet):
    """La version aprobada (main) de una web, construida y servida solo en este PC durante un rato.

    Se construye desde ese commit exacto, nunca desde la carpeta de trabajo, que puede estar en la rama de un agente.
    """
    proyecto = comprobar_proyecto(pet.get("proyecto"))
    if plantilla_de(proyecto) is None:
        raise Rechazo("ese proyecto no es una web profesional.")
    sha = git(PROYECTOS / proyecto, "rev-parse", "--verify", "refs/heads/main^{commit}").strip()
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise Rechazo("no se puede leer main.")
    codigo, texto = pedir_vista(proyecto, sha)
    if codigo != "0":
        raise Rechazo(f"no se ha podido abrir la web: {visible(texto[-300:])}")
    return {"mensaje": f"Lista: la versión aprobada de {proyecto} (main, {sha[:7]}) se ve en este PC durante {VISTA_MIN} minutos.",
            "url": f"http://127.0.0.1:{PUERTO_VISTA}/", "commit": sha[:7]}


