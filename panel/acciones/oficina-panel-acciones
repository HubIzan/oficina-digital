def plantilla_de(proyecto):
    """Que plantilla web usa un proyecto, mirando sus archivos sin ejecutar nada. None si no es una web profesional."""
    p = PROYECTOS / proyecto
    try:
        if not (p / "sitio.config.json").is_file() or (p / "sitio.config.json").is_symlink():
            return None
        paquete = (p / "package.json").read_text(encoding="utf-8", errors="replace")[:20000] if (p / "package.json").is_file() else ""
    except OSError:
        return None
    return "astro" if '"astro"' in paquete else "web-pro"


