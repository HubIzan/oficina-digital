NIF_RE = re.compile(r"^[0-9A-Z][0-9]{7}[0-9A-Z]\Z")
CORREO_RE = re.compile(r"^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,180}\.[A-Za-z]{2,24}\Z")
DOMINIO_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\.[a-z]{2,24}\Z")
TIEMPO_GIT_S = 30
TIEMPO_MERGE_S = 1700
SENSIBLES = (".github", ".gitattributes", ".gitmodules", ".gitignore", ".dockerignore", ".npmrc", ".env", "Dockerfile", "compose.yaml",
             "Makefile", "requirements.txt", "pyproject.toml", "uv.lock", "package.json", "package-lock.json")
ENTORNO_GIT = {"GIT_NO_REPLACE_OBJECTS": "1", "GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_ALLOW_PROTOCOL": ""}
# Los repositorios son escribibles por agente: Git no debe ejecutar nada de ellos.
GIT = ("git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "core.quotepath=true",
       "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=never")


class Rechazo(Exception):
    pass


def cargar_mando():
    # La ruta solo cambia en las pruebas; el servicio arranca con un entorno fijo.
    cargador = importlib.machinery.SourceFileLoader("oficina_mando", os.environ.get("OFICINA_MANDO", "/usr/local/bin/oficina"))
    modulo = importlib.util.module_from_spec(importlib.util.spec_from_loader("oficina_mando", cargador))
    cargador.exec_module(modulo)
    return modulo


mando = cargar_mando()


def visible(texto, maximo=None):
    """Quita controles de terminal y deja a la vista los caracteres que reordenan lo que se lee."""
    texto = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", texto)
    texto = re.sub(r"[‪-‮⁦-⁩​-‏  ﻿]", lambda m: f"⟦U+{ord(m.group()):04X}⟧", texto)
    return texto if maximo is None else texto[:maximo]


def git(repo, *argumentos):
    r = subprocess.run([*GIT, "-C", str(repo), "--no-pager", *argumentos], stdin=subprocess.DEVNULL,
                       capture_output=True, timeout=TIEMPO_GIT_S, check=False, env={**os.environ, **ENTORNO_GIT})
    if r.returncode:
        raise Rechazo("Git no ha podido leer el repositorio.")
    return r.stdout.decode("utf-8", errors="replace")


def entrega(*argumentos, tiempo=TIEMPO_GIT_S):
    r = subprocess.run(["oficina-entrega", *argumentos], stdin=subprocess.DEVNULL, capture_output=True,
                       timeout=tiempo, check=False)
    if r.returncode:
        lineas = r.stderr.decode("utf-8", errors="replace").strip().splitlines()
        raise Rechazo(visible(lineas[-1], 300) if lineas else "la entrega ha fallado.")


def buscar(id_tarea):
    if not isinstance(id_tarea, str) or not ID_RE.match(id_tarea):
        raise Rechazo("identificador no valido.")
    f, t = mando.buscar(id_tarea)
    proyecto = t.get("proyecto")
    if not isinstance(proyecto, str) or not mando.NOMBRE.match(proyecto):
        raise Rechazo("proyecto no valido.")
    # El estado sale de la carpeta; lo que diga el archivo puede estar manipulado.
    return f, t, f.parent.name


def leer_spec(proyecto, id_tarea):
    """Lee la especificacion sin seguir enlaces: este proceso ve mas archivos que el panel."""
    ruta = BOVEDA
    for parte in ("Proyectos", proyecto, "Especificaciones", f"{id_tarea}.md"):
        ruta = ruta / parte
        try:
            info = os.lstat(ruta)
        except OSError as e:
            raise Rechazo("la especificacion no existe.") from e
        if stat.S_ISLNK(info.st_mode):
            raise Rechazo("la especificacion es un enlace: no se abre.")
    if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_NOTA:
        raise Rechazo("la especificacion no es un archivo normal.")
    return ruta.read_bytes()


def detalle_spec(base, proyecto, id_tarea):
    contenido = leer_spec(proyecto, id_tarea)
    huella = hashlib.sha256(contenido).hexdigest()
    return {**base, "tipo": "especificacion", "huella": huella, "frase": f"aprobar spec {proyecto} {huella[:7]}",
            "texto": visible(contenido.decode("utf-8", errors="replace"))}, contenido


def leer_auditoria(id_tarea, proyecto, sha):
    """La segunda opinion de este commit exacto. Es informativa: nada de aqui decide un merge."""
    try:
        config = json.loads(CONFIG_AUDITORIA.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        config = {}
    if not isinstance(config, dict) or proyecto not in (config.get("proyectos") or []):
        return {"estado": "desactivada"}
    nombre = f"{id_tarea}-{sha}"
    motivo = AUDITORIA / "entrada" / f"{nombre}.estado"
    if motivo.is_file() and not motivo.is_symlink():
        return {"estado": "no-enviada", "motivo": {"grande": "el diff es demasiado grande", "secretos": "puede contener secretos, o no se ha podido comprobar"}.get(motivo.read_text(encoding="ascii", errors="replace"), "sin motivo")}
    ruta = AUDITORIA / "salida" / f"{nombre}.json"
    try:
        fd = os.open(ruta, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return {"estado": "pendiente"}
    with os.fdopen(fd, "rb") as f:
        crudo = f.read(MAX_AUDITORIA + 1)
    try:
        d = json.loads(crudo) if len(crudo) <= MAX_AUDITORIA else None
    except ValueError:
        d = None
    if not isinstance(d, dict) or d.get("veredicto") not in ("SIN_OBJECIONES", "OBJECIONES", "NO_CONCLUYE") or d.get("huella") != sha:
        return {"estado": "pendiente"}
    hallazgos = [h for h in d.get("hallazgos", []) if isinstance(h, dict)][:30] if isinstance(d.get("hallazgos"), list) else []
    return {"estado": "lista", "veredicto": d["veredicto"], "resumen": visible(str(d.get("resumen", "")), 3000),
            "proveedor": visible(str(d.get("proveedor", "")), 30), "modelo": visible(str(d.get("modelo", "")), 60),
            "hallazgos": [{"gravedad": h.get("gravedad") if h.get("gravedad") in ("alta", "media", "baja") else "media",
                           "archivo": visible(str(h.get("archivo", "")), 300), "descripcion": visible(str(h.get("descripcion", "")), 1500)} for h in hallazgos]}


def detalle_merge(base, proyecto, t):
    rama = t.get("rama")
    if not isinstance(rama, str) or not RAMA_RE.match(rama):
        raise Rechazo("el nombre de la rama no es valido.")
    entrega("revisar", proyecto)
    repo = PROYECTOS / proyecto
    sha = git(repo, "rev-parse", "--verify", f"refs/heads/{rama}^{{commit}}").strip()
    principal = git(repo, "rev-parse", "--verify", "refs/heads/main^{commit}").strip()
    rango = f"{principal}...{sha}"
    commits = []
    for linea in git(repo, "log", f"-n{MAX_COMMITS}", "--format=%h%x09%an%x09%s", f"{principal}..{sha}").splitlines():
        partes = (linea.split("\t", 2) + ["", ""])[:3]
        commits.append({"sha": partes[0][:12], "autor": visible(partes[1], 80), "asunto": visible(partes[2], 200)})
    if not commits:
        raise Rechazo("la rama no tiene commits nuevos.")
    archivos = []
    # --text: ni los atributos ni un byte nulo pueden convertir codigo en "archivo binario".
    opciones = ("--no-ext-diff", "--no-textconv", "--text", "--no-color", "--no-renames")
    for linea in git(repo, "diff", *opciones, "--numstat", rango).splitlines():
        partes = (linea.split("\t", 2) + ["", ""])[:3]
        archivos.append({"anadidas": partes[0][:8], "quitadas": partes[1][:8], "ruta": visible(partes[2], 300)})
    crudo = git(repo, "diff", *opciones, rango)
    lineas = crudo.split("\n")
    recortado = len(crudo.encode("utf-8")) > MAX_DIFF or len(lineas) > MAX_LINEAS_DIFF
    if recortado:
        crudo = "\n".join(lineas[:MAX_LINEAS_DIFF]).encode("utf-8")[:MAX_DIFF].decode("utf-8", errors="ignore").rsplit("\n", 1)[0]
    sensibles = {a["ruta"] for a in archivos if a["ruta"].strip('"').split("/")[-1] in SENSIBLES or a["ruta"].strip('"').split("/")[0] in SENSIBLES}
    # Enlaces, submodulos y ejecutables nuevos: el diff los muestra en una linea facil de pasar por alto.
    for linea in git(repo, "diff", "--no-renames", "--summary", rango).splitlines():
        m = re.match(r"^ (?:create|mode change \d+ =>|mode change) ?(?:mode )?(120000|160000|100755) (.+)\Z", linea)
        if m:
            sensibles.add(visible(m.group(2), 300))
    return {**base, "tipo": "merge", "rama": rama, "huella": sha, "base": principal, "frase": f"aprobar {proyecto} {sha[:7]}",
            "qa_coincide": mando.qa_aprobo(t, sha), "orden_qa": f"oficina repetir-qa {base['tarea']}",
            "commits": commits, "archivos": archivos, "sensibles": sorted(sensibles), "diff": visible(crudo), "recortado": recortado,
            "lineas_largas": sum(1 for x in lineas if len(x) > ANCHO_SOSPECHOSO),
            "auditoria": leer_auditoria(base["tarea"], proyecto, sha)}, None


def detalle_investigacion(base, proyecto, t):
    """El informe sale de paginas web: se muestra como texto y la frase se ata a esta version exacta."""
    i = mando.informe_valido(t)
    if i is None:
        raise Rechazo("esa investigacion no tiene un informe valido: rechazala y vuelve a encargar.")
    i = json.loads(visible(json.dumps(i, ensure_ascii=False)))
    huella = hashlib.sha256(json.dumps(i, ensure_ascii=False, sort_keys=True).encode("utf-8")).hexdigest()
    return {**base, "tipo": "investigacion", "huella": huella, "frase": f"seguir {proyecto} {huella[:7]}", "informe": i,
            "nombre_existe": mando.NOMBRE_EXISTE[i["existe"]], "nombre_recomendacion": mando.NOMBRE_RECOMENDACION[i["recomendacion"]]}, None


def calcular_detalle(id_tarea):
    f, t, estado = buscar(id_tarea)
    proyecto = t["proyecto"]
    veredicto = t.get("veredicto") if t.get("veredicto") in ("APROBADO", "RECHAZADO") else None
    base = {"tarea": id_tarea, "proyecto": proyecto, "objetivo": visible(str(t.get("objetivo", "")), 400),
            "veredicto": veredicto, "frase_rechazo": f"rechazar {proyecto}"}
    if estado == "espera" and isinstance(t.get("pregunta"), str):
        # Se contesta desde la isla (tarea_responder): aqui no hay nada que aprobar.
        d, contenido = {**base, "tipo": "pregunta", "pregunta": visible(t["pregunta"], 500)}, None
    elif estado == "espera" and t.get("rol") == "investigador":
        d, contenido = detalle_investigacion(base, proyecto, t)
    elif estado == "espera" and t.get("rol") == "arquitecto":
        d, contenido = detalle_spec(base, proyecto, id_tarea)
    elif estado == "revision":
        d, contenido = detalle_merge(base, proyecto, t)
    elif estado == "espera":
        d, contenido = {**base, "tipo": "decision"}, None
    else:
        raise Rechazo("esa tarea ya no espera tu aprobacion.")
    return d, contenido, f, t


def detalle(pet):
    return calcular_detalle(pet.get("tarea"))[0]


def aprobar(pet):
    d, contenido, f, t = calcular_detalle(pet.get("tarea"))
    if d["tipo"] == "decision":
        raise Rechazo("esta decision no se aprueba desde el panel: revisala en la terminal.")
    if d["tipo"] == "pregunta":
        raise Rechazo("esta tarea espera un dato, no una aprobacion: contestala en la isla.")
    huella = pet.get("huella")
    if not isinstance(huella, str) or not HUELLA_RE.match(huella) or huella != d["huella"]:
        raise Rechazo("ha cambiado desde que lo revisaste: vuelve a cargarlo y revisalo otra vez.")
    if pet.get("frase") != d["frase"]:
        raise Rechazo("la frase no coincide: no se ha hecho nada.")
    if d["tipo"] == "especificacion":
        mando.aplicar_spec(f, t, contenido)
        return {"mensaje": "Especificación aprobada. El desarrollo queda en cola."}
    if d["tipo"] == "investigacion":
        comprobar_proyecto(d["proyecto"])
        matiz = visible(pet["matiz"], MAX_MATIZ).strip() if isinstance(pet.get("matiz"), str) else ""
        encargo = mando.aplicar_seguir(f, t, matiz)
        return {"mensaje": "Sigue adelante: el Arquitecto escribirá la especificación con lo investigado, y volverá a pedir tu aprobación.",
                "encargo": encargo["id"]}
    if not d["qa_coincide"]:
        raise Rechazo(f"QA no ha aprobado este commit: repite la revision en la terminal con {d['orden_qa']}")
    if d["recortado"]:
        raise Rechazo("el diff es demasiado grande para verlo aqui: revisalo y apruebalo en la terminal.")
    with mando.pausa_temporal():
        mando.comprobar_sin_tarea()
        entrega("aprobar-panel", d["proyecto"], d["rama"], d["huella"], tiempo=TIEMPO_MERGE_S)
        mando.cerrar_revision(d["proyecto"], d["rama"])
    p = d["proyecto"]
    donde = f"Está en main de {p}, en este PC: \\\\wsl.localhost\\Ubuntu\\srv\\oficina\\proyectos\\{p}"
    if plantilla_de(p) is not None:
        return {"mensaje": f"Merge hecho. {donde}. No se ha subido nada a GitHub. Para verla: «Ver la web» en la pestaña Web de la isla.",
                "proyecto": p, "web": True}
    return {"mensaje": f"Merge hecho. {donde}. No se ha subido nada a GitHub.", "proyecto": p}


def rechazar(pet):
    f, t, _ = buscar(pet.get("tarea"))
    if pet.get("frase") != f"rechazar {t['proyecto']}":
        raise Rechazo("la frase no coincide: no se ha hecho nada.")
    motivo = pet.get("motivo") if isinstance(pet.get("motivo"), str) else ""
    mando.aplicar_rechazo(f, t, visible(motivo, 300))
    return {"mensaje": "Rechazado. La rama, si la hay, se conserva y no entra en main."}


def proyectos_disponibles():
    try:
        nombres = sorted(os.listdir(PROYECTOS))
    except OSError:
        return []
    return [n for n in nombres if mando.NOMBRE.match(n) and not os.path.islink(PROYECTOS / n) and (PROYECTOS / n / ".git").is_dir()]


def comprobar_proyecto(proyecto):
    if not isinstance(proyecto, str) or proyecto not in proyectos_disponibles():
        raise Rechazo("ese proyecto no existe.")
    return proyecto


def comprobar_texto(texto):
    if not isinstance(texto, str):
        raise Rechazo("el mensaje no es valido.")
    limpio = visible(texto).strip()
    if not limpio or len(limpio) > MAX_MENSAJE:
        raise Rechazo(f"escribe un mensaje de hasta {MAX_MENSAJE} caracteres.")
    return limpio


def huella_de(texto):
    return hashlib.sha256(texto.encode("utf-8")).hexdigest()


def frase_de_encargo(proyecto, texto):
    return f"encargar {proyecto} {huella_de(texto)[:7]}"


def tareas_de_triage():
    """Las conversaciones, de la mas antigua a la mas reciente. Lo que no encaja se ignora."""
    salida = []
    for carpeta in mando.ESTADOS:
        for f in (mando.COLA / carpeta).glob("*.json"):
            if f.is_symlink():
                continue
            try:
                t = mando.leer(f)
            except (OSError, ValueError):
                continue
            if isinstance(t, dict) and t.get("rol") == "triage" and isinstance(t.get("proyecto"), str) and mando.NOMBRE.match(t["proyecto"]) and ID_RE.match(f.stem):
                salida.append((f, t, carpeta))
    return sorted(salida, key=lambda x: x[0].name)


def textos(v, cuantos, largo):
    return [visible(x, largo) for x in v if isinstance(x, str)][:cuantos] if isinstance(v, list) else []


def objetivo_elegido(propuesta, alternativa):
    return f"{propuesta.get('objetivo')}\n\nAlternativa elegida: {alternativa.get('titulo')}. {alternativa.get('descripcion', '')}".strip()


def propuesta_visible(t):
    """Vuelve a mirar los tipos, y calcula aqui la frase de cada alternativa: es la que se comprueba al aprobar."""
    p = t.get("propuesta")
    if not isinstance(p, dict) or not isinstance(p.get("objetivo"), str) or not isinstance(p.get("resumen"), str):
        return None
    opciones = []
    for i, a in enumerate((p.get("alternativas") if isinstance(p.get("alternativas"), list) else [])[:MAX_ALTERNATIVAS]):
        if not isinstance(a, dict) or not isinstance(a.get("titulo"), str):
            continue
        objetivo = objetivo_elegido(p, a)
        opciones.append({"indice": i, "titulo": visible(a["titulo"], 100), "descripcion": visible(str(a.get("descripcion", "")), 500),
                         "complejidad": a.get("complejidad") if a.get("complejidad") in ("BAJA", "MEDIA", "ALTA") else "MEDIA",
                         "huella": huella_de(objetivo), "frase": frase_de_encargo(t["proyecto"], objetivo)})
    if not opciones:
        return None
    recomendada = p.get("recomendada") if isinstance(p.get("recomendada"), int) else 0
    return {"resumen": visible(p["resumen"], 500), "objetivo": visible(p["objetivo"], 3000), "alcance": textos(p.get("alcance"), 8, 200),
            "fuera": textos(p.get("fuera"), 8, 200), "riesgos": textos(p.get("riesgos"), 6, 200), "opciones": opciones, "recomendada": recomendada,
            "pregunta": visible(p["pregunta"], 300) if isinstance(p.get("pregunta"), str) else ""}


def triage_lista(_):
    items = []
    for f, t, carpeta in tareas_de_triage()[-MAX_CONVERSACION:]:
        items.append({"tarea": f.stem, "estado": carpeta, "proyecto": t["proyecto"], "mensaje": visible(str(t.get("objetivo", "")), MAX_MENSAJE),
                      "error": visible(str(t.get("error", "")), 400), "encargo": visible(str(t.get("encargo", "")), 40),
                      "cancelada": t.get("cancelada") is True, "propuesta": propuesta_visible(t) if carpeta == "espera" else None})
    proyectos = proyectos_disponibles()
    # Lo que la isla marca por defecto: igual que en la terminal, se investiga en los proyectos nuevos.
    return {"proyectos": proyectos, "items": items, "listo": "triage" in mando.leer(mando.CONTROL / "roles.json"),
            "investigador": mando.rol_aplicado("investigador"),
            "sin_especificaciones": [p for p in proyectos if not mando.hay_especificaciones(p)],
            "atencion": atencion()}


# El error de la cola es tecnico: esto es lo que significa para una persona.
FALLOS_CONOCIDOS = (
    ("no hay commits nuevos", "Terminó sin entregar ningún cambio."),
    ("han quedado cambios sin commit", "Dejó cambios a medias, sin guardar."),
    ("ha pedido un dato pero", "Pidió un dato, pero dejó cambios a medias sin guardar."),
    ("no se ha escrito la especificacion", "Terminó sin escribir la especificación."),
    ("la especificacion aprobada ha cambiado", "La especificación cambió después de aprobarla: por seguridad no se sigue."),
    ("la rama ha cambiado", "La rama cambió mientras se revisaba: por seguridad no se da por buena."),
    ("QA no ha dado un veredicto", "QA terminó sin decir si lo aprueba o no."),
    ("no ha devuelto", "Respondió sin el formato que se le pide."),
    ("terminado sin resultado", "Se cortó antes de terminar."),
    ("terminado sin avisar", "Se cortó antes de terminar."),
    ("error_max_turns", "Se quedó sin pasos antes de terminar: el encargo puede ser demasiado grande."),
    ("peticion rechazada", "La Oficina rechazó la tarea por estar mal formada."),
)
MAX_EXPLICACION = 1500


def motivo_claro(error):
    return next((claro for clave, claro in FALLOS_CONOCIDOS if clave in error), "Ha fallado por un error técnico.")


def explicacion_registrada(id_tarea):
    """Para tareas que fallaron antes de guardarse la explicacion: la ultima respuesta del agente en su registro."""
    try:
        fd = os.open(mando.RAIZ / "registro" / f"{id_tarea}.jsonl", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return ""
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            return ""
        f.seek(max(0, os.fstat(f.fileno()).st_size - 256 * 1024))
        lineas = f.read().splitlines()
    for linea in reversed(lineas):
        try:
            ev = json.loads(linea)
        except (ValueError, RecursionError):
            continue
        if isinstance(ev, dict) and ev.get("type") == "result" and isinstance(ev.get("result"), str):
            return ev["result"][-MAX_EXPLICACION:]
    return ""


NOMBRE_ROL = {"arquitecto": "Arquitecto", "desarrollador": "Desarrollador", "qa": "QA", "investigador": "Investigador",
              "devops": "DevOps", "triage": "Triage"}


def atencion():
    """Lo que te necesita en la isla: tareas que piden un dato y tareas que han fallado. Lo de Triage va en su chat."""
    salida = []
    for carpeta in ("espera", "fallida"):
        for f in sorted((mando.COLA / carpeta).glob("*.json"))[-MAX_ATENCION:]:
            if f.is_symlink() or not ID_RE.match(f.stem):
                continue
            try:
                t = mando.leer(f)
            except (OSError, ValueError):
                continue
            if not isinstance(t, dict) or t.get("rol") == "triage" or not mando.NOMBRE.match(str(t.get("proyecto", ""))):
                continue
            if carpeta == "espera" and not isinstance(t.get("pregunta"), str):
                continue
            item = {"tarea": f.stem, "tipo": "pregunta" if carpeta == "espera" else "fallo", "proyecto": t["proyecto"],
                    "rol": NOMBRE_ROL.get(t.get("rol"), "Agente"), "objetivo": visible(str(t.get("objetivo", "")), 200)}
            if carpeta == "espera":
                item.update(texto=visible(t["pregunta"], 600), explicacion="", detalle="")
            else:
                error = str(t.get("error") or "")
                explicacion = t["explicacion"] if isinstance(t.get("explicacion"), str) else explicacion_registrada(f.stem)
                # Lo escribe el agente: se muestra como texto, recortado y sin controles.
                item.update(texto=motivo_claro(error), explicacion=visible(explicacion, MAX_EXPLICACION).strip(), detalle=visible(error, 600))
            salida.append(item)
    return salida


def tarea_atendible(pet):
