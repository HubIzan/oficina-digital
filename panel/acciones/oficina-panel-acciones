def creados_hoy():
    """Proyectos que siguen en disco y se crearon en las ultimas 24 horas.

    Git escribe .git/description al crear el repositorio y nada lo vuelve a tocar: sirve de fecha de
    creacion. Si se borra un proyecto, deja de contar; asi las pruebas no agotan el limite.
    """
    limite = time.time() - 86400
    n = 0
    for nombre in proyectos_disponibles():
        with contextlib.suppress(OSError):
            if os.lstat(PROYECTOS / nombre / ".git" / "description").st_mtime > limite:
                n += 1
    return n


def proyecto_nuevo(pet):
    """Crea un proyecto en local desde una plantilla. Nada sale del PC: publicarlo sigue siendo cosa de la terminal."""
    nombre, tipo = pet.get("nombre"), pet.get("tipo")
    if not isinstance(nombre, str) or not mando.NOMBRE.match(nombre):
        raise Rechazo("nombre no valido: usa minusculas, numeros y guiones, empezando por letra o numero.")
    if tipo not in mando.PLANTILLAS:
        raise Rechazo(f"el tipo debe ser uno de: {', '.join(mando.PLANTILLAS)}.")
    if os.path.lexists(PROYECTOS / nombre):
        raise Rechazo("ya existe un proyecto con ese nombre.")
    if pet.get("frase") != f"crear {nombre} {tipo}":
        raise Rechazo("la frase no coincide: no se ha creado nada.")
    if creados_hoy() >= MAX_PROYECTOS_DIA:
        raise Rechazo(f"ya hay {MAX_PROYECTOS_DIA} proyectos creados en las ultimas 24 horas: el resto, en la terminal.")
    entrega("nuevo", nombre, tipo, tiempo=60)
    return {"mensaje": f"Proyecto {nombre} creado en local. Ya puedes encargarle algo.", "proyecto": nombre}


