    return encargar(e["proyecto"], objetivo_web(e, id_nota), "MEDIA", pet.get("investigar"), pet.get("opus"))


ACCIONES = {"detalle": detalle, "aprobar": aprobar, "rechazar": rechazar, "triage_lista": triage_lista, "triage_pedir": triage_pedir,
            "triage_aprobar": triage_aprobar, "triage_preparar": triage_preparar, "triage_directo": triage_directo, "triage_descartar": triage_descartar,
            "proyecto_nuevo": proyecto_nuevo, "web_estado": web_estado, "web_referencia": web_referencia,
            "web_quitar_referencia": web_quitar_referencia, "web_preparar": web_preparar, "web_encargar": web_encargar,
            "tarea_responder": tarea_responder, "tarea_reintentar": tarea_reintentar, "tarea_cancelar": tarea_cancelar, "ver_web": ver_web}
# ver_web no cambia nada de la Oficina, pero construye con Docker: va con el bloqueo para que no haya dos a la vez.
MUTAN = {"aprobar", "rechazar", "triage_pedir", "triage_aprobar", "triage_directo", "triage_descartar", "proyecto_nuevo",
         "web_referencia", "web_quitar_referencia", "web_encargar", "tarea_responder", "tarea_reintentar", "tarea_cancelar", "ver_web"}


def anotar(pet, resultado):
    tarea = pet.get("nombre") if pet.get("accion") == "proyecto_nuevo" else pet.get("tarea")
    linea = {"hora": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "accion": pet.get("accion"), "tarea": str(tarea)[:64],
             "huella": str(pet.get("huella"))[:64], "nodo": str(pet.get("nodo"))[:20], "resultado": resultado[:300]}
    with open(REGISTRO, "a", encoding="utf-8") as r:
        r.write(json.dumps(linea, ensure_ascii=False) + "\n")


def ejecutar(pet):
    accion = pet.get("accion")
    if not isinstance(accion, str) or accion not in ACCIONES:
        return {"ok": False, "error": "accion desconocida."}
    if accion not in MUTAN:
        return {"ok": True, **ACCIONES[accion](pet)}
    with open(BLOQUEO, "a", encoding="utf-8") as b:
        try:
            fcntl.flock(b, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return {"ok": False, "error": "hay otra accion en marcha: espera a que termine."}
        try:
            r = {"ok": True, **ACCIONES[accion](pet)}
        except (Exception, SystemExit) as e:
            anotar(pet, f"rechazada: {e}")
            raise
        anotar(pet, "hecha")
        return r


def cliente_permitido():
    s = socket.socket(fileno=os.dup(0))
    try:
        _, uid, _ = struct.unpack("3i", s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
    finally:
        s.close()
    return uid == pwd.getpwnam("panel").pw_uid


def main():
    salida = sys.stdout.buffer
    capturado = io.StringIO()
    try:
        if not cliente_permitido():
            respuesta = {"ok": False, "error": "cliente no permitido."}
        else:
            crudo = sys.stdin.buffer.readline(MAX_PETICION_IMAGEN + 1)
            pet = json.loads(crudo) if len(crudo) <= MAX_PETICION_IMAGEN else None
            if not isinstance(pet, dict):
                raise Rechazo("peticion no valida.")
            # Solo la imagen puede ser grande: el resto conserva el limite de siempre.
            if pet.get("accion") != "web_referencia" and len(crudo) > MAX_PETICION:
                raise Rechazo("peticion no valida.")
            with contextlib.redirect_stdout(capturado):
                respuesta = ejecutar(pet)
    except Rechazo as e:
        respuesta = {"ok": False, "error": str(e)}
    except SystemExit as e:
        respuesta = {"ok": False, "error": visible(str(e.code), 300)}
    except subprocess.TimeoutExpired:
        respuesta = {"ok": False, "error": "la operacion ha tardado demasiado."}
    except Exception as e:  # noqa: BLE001  Lo que escriben los agentes no debe romper el canal sin respuesta.
        print(f"oficina-panel-acciones: {e!r}", file=sys.stderr)
        respuesta = {"ok": False, "error": "error interno del canal."}
    salida.write(json.dumps(respuesta, ensure_ascii=False).encode("utf-8") + b"\n")
    salida.flush()


if __name__ == "__main__":
    main()
