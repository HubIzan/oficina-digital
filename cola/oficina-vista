#!/usr/bin/env bash
# Vista local de una web: construye un commit exacto (el main que aprobaste) y lo sirve solo en 127.0.0.1:8092.
# Lo pide el canal de acciones, que no tiene red; el socket solo lo abre tu usuario (ni agente ni el panel).
# Una conexion, una peticion: "<proyecto> <sha>". La ultima linea de la salida es: __CODIGO__ <n>
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
PUERTO=8092
MINUTOS=30
CONTENEDOR=oficina-vista

terminar() { printf '%s\n__CODIGO__ %s\n' "${2:-}" "$1"; exit 0; }
como_clones() { timeout 600 setpriv --reuid=clones --regid=clones --clear-groups --no-new-privs "$@"; }

IFS= read -r -t 10 peticion || terminar 2 "Sin peticion."
nombre="${peticion%% *}"
sha="${peticion#* }"
[[ "$nombre" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || terminar 2 "Nombre no valido."
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || terminar 2 "Commit no valido."
p="/srv/oficina/proyectos/$nombre"
[ -d "$p" ] && [ ! -L "$p" ] || terminar 2 "No existe el proyecto."

t="$(mktemp -d /var/tmp/oficina-vista.XXXXXX)" || terminar 2 "No se puede crear la copia."
trap 'rm -rf "$t"' EXIT
chmod 0700 "$t"
chown clones:clones "$t"
c="$t/contexto"
# clones solo lee: ni el codigo de los agentes ni un fallo de Git al leerlo llegan a root.
como_clones /usr/local/sbin/oficina-clon "$p/.git" "$c" "$sha" --sin-git >/dev/null 2>&1 || terminar 2 "No se ha podido sacar ese commit."

[ -f "$c/Dockerfile" ] && [ ! -L "$c/Dockerfile" ] || terminar 2 "No hay un Dockerfile normal."
# "# syntax=" haria que Docker ejecutase un constructor elegido por el proyecto.
grep -qiE '^[[:space:]]*#[[:space:]]*syntax[[:space:]]*=' "$c/Dockerfile" && terminar 2 "Dockerfile con directiva syntax: no se construye."
grep -qE '^[[:space:]]*FROM[[:space:]].*[[:space:]]AS[[:space:]]+final[[:space:]]*$' "$c/Dockerfile" || terminar 2 "El Dockerfile no tiene la etapa final de la plantilla."

imagen="oficina-vista-$nombre"
salida="$(timeout 900 docker build -q --target final -t "$imagen" "$c" 2>&1)" || terminar 1 "No se ha podido construir: $(printf '%s' "$salida" | tail -n 3)"
docker rm -f "$CONTENEDOR" >/dev/null 2>&1
# Sin privilegios, sin escritura salvo /tmp, solo en este PC y con apagado propio.
salida="$(docker run -d --rm --name "$CONTENEDOR" --read-only --tmpfs /tmp:size=16m \
  --cap-drop ALL --security-opt no-new-privileges --pids-limit 64 --memory 256m --cpus 1 \
  -p "127.0.0.1:$PUERTO:8080" --entrypoint /bin/sh "$imagen" -c "exec timeout $((MINUTOS * 60)) nginx -g 'daemon off;'" 2>&1)" \
  || terminar 1 "No se ha podido abrir la vista: $(printf '%s' "$salida" | tail -n 2)"
for i in $(seq 1 20); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PUERTO/")" = 200 ] && terminar 0 "Lista."
  sleep 0.5
done
terminar 1 "La vista no responde."
