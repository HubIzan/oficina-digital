def aplicar_rechazo(f, t, motivo):
    """Retira lo que esperaba tu decision. No encarga trabajo nuevo: eso gastaria cuota."""
    if f.parent.name not in ("espera", "revision"):
        morir("solo se rechaza lo que espera tu aprobacion.")
    t.update(estado="hecha", cancelada=True, rechazada=True, motivo_rechazo=motivo[:300])
    guardar(COLA / "hecha" / f.name, t)
    f.unlink()


