    f.unlink()
    lanzar_aviso(q)


def frontmatter(texto):
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", texto, flags=re.S)
    if not m:
        return None, None
    campos = {}
    for linea in m.group(1).splitlines():
        if ":" in linea:
            k, v = linea.split(":", 1)
            campos[k.strip()] = v.strip()
    return campos, m.group(2).strip()


def roles(_):
    # Las notas viven donde agente puede escribir: aqui se revisan y se fija una copia que no puede tocar.
    resultado = {}
    for nombre, permitidas in ROLES.items():
        nota = BOVEDA / "Agentes" / f"{nombre}.md"
        if not nota.is_file():
            morir(f"falta la nota {nota}")
        campos, cuerpo = frontmatter(nota.read_text(encoding="utf-8"))
        if not campos or not cuerpo:
            morir(f"nota mal formada: {nota}")
        herramientas = [h.strip() for h in campos.get("herramientas", "").split(",") if h.strip()]
        ajenas = set(herramientas) - set(permitidas)
        if ajenas or not herramientas:
            morir(f"{nombre}: herramientas no permitidas: {sorted(ajenas) or 'ninguna indicada'}")
        resultado[nombre] = {
            "description": campos.get("descripcion", nombre),
            "prompt": cuerpo,
            "tools": herramientas,
            "model": campos.get("modelo", "sonnet"),
        }
    destino = CONTROL / "roles.json"
    anterior = leer(destino) if destino.is_file() else {}
    if anterior == resultado:
        print("Los roles ya estan aplicados.")
        return
    for nombre, r in resultado.items():
        cambio = "sin cambios" if anterior.get(nombre) == r else "CAMBIA"
        print(f"\n== {nombre} ({cambio}): modelo {r['model']}, herramientas {', '.join(r['tools'])}")
        if cambio == "CAMBIA":
            print(r["prompt"])
    confirmar("aplicar roles")
    destino.write_text(json.dumps(resultado, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    destino.chmod(0o644)
    print("Roles aplicados.")


def auditar(a):
